# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
# To use OpenRouter:
OPENROUTER_API_KEY=your_openrouter_key_here
DEFAULT_LLM_MODEL=openrouter/anthropic/claude-3.5-sonnet
FALLBACK_LLM_MODEL=openrouter/openai/gpt-4o

# To use direct providers:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Tool API Keys
SERPER_API_KEY=
TAVILY_API_KEY=
NEWS_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
