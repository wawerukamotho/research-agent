# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/research
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
# To use OpenRouter:
OPENROUTER_API_KEY=your_openrouter_key_here
# Suggested Free Models:
# - google/gemini-flash-1.5-8b:free (High rate limits, very reliable)
# - meta-llama/llama-3.1-8b-instruct:free
# - qwen/qwen-2-7b-instruct:free
DEFAULT_LLM_MODEL=openrouter/google/gemini-flash-1.5-8b:free
FALLBACK_LLM_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct:free

# To use direct providers:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Tool API Keys
SERPER_API_KEY=
TAVILY_API_KEY=
NEWS_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
